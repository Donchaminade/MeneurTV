# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Also used at build time for SEO: canonical, Open Graph, sitemap.xml and robots.txt.
# En local : copie en .env avec APP_URL=https://meneur-tv.vercel.app (ou ton domaine).
# Sur Vercel : défini aussi dans vercel.json → build.env pour ce projet.
APP_URL="MY_APP_URL"

# Google Search Console — optionnel : valeur de l'attribut content= de la balise meta « Balise HTML ».
# Injectée dans index.html au build. Sur Vercel : Project → Settings → Environment Variables → Production.
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
