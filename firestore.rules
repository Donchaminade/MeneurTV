rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.email is string && 
               data.email.size() <= 200 &&
               data.favorites is list &&
               data.favorites.size() <= 1000 &&
               data.isAdmin is bool &&
               (data.isActive == null || data.isActive is bool) &&
               (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
               (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
               (data.isProfileComplete == null || data.isProfileComplete is bool) &&
               data.createdAt is timestamp;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      (incoming().isAdmin == false || request.auth.token.email == 'chaminade.dondah.adjolou@gmail.com') &&
                      incoming().createdAt == request.time;
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) &&
                      incoming().isAdmin == existing().isAdmin &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().email == existing().email &&
                      (incoming().diff(existing()).affectedKeys().hasOnly(['favorites', 'displayName', 'photoURL', 'phoneNumber', 'isProfileComplete']));
      allow update: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      function isValidSetting(data) {
        return (data.donationFlooz == null || (data.donationFlooz is string && data.donationFlooz.size() <= 200)) &&
               (data.donationYas == null || (data.donationYas is string && data.donationYas.size() <= 200)) &&
               (data.donationBank == null || (data.donationBank is string && data.donationBank.size() <= 500)) &&
               (data.donationTMoney == null || (data.donationTMoney is string && data.donationTMoney.size() <= 200)) &&
               (data.donationVisa == null || (data.donationVisa is string && data.donationVisa.size() <= 500)) &&
               (data.supportMessage == null || (data.supportMessage is string && data.supportMessage.size() <= 1000)) &&
               data.updatedAt is timestamp;
      }

      allow read: if true;
      allow write: if isAdmin() && isValidSetting(incoming());
    }

    // Views collection (activity logs)
    match /views/{viewId} {
      function isValidView(data) {
        return data.channelId is string && data.channelId.size() <= 128 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.timestamp is timestamp;
      }

      allow read: if isAdmin();
      allow create: if isSignedIn() && 
                      isOwner(incoming().userId) &&
                      isValidView(incoming()) &&
                      incoming().timestamp == request.time;
    }

    // Ratings collection
    match /ratings/{ratingId} {
      function isValidRating(data) {
        return data.channelId is string && data.channelId.size() <= 128 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.timestamp is timestamp;
      }

      allow read: if true;
      allow create: if isSignedIn() && 
                      isOwner(incoming().userId) &&
                      isValidRating(incoming()) &&
                      incoming().timestamp == request.time;
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) && 
                      isOwner(incoming().userId) &&
                      isValidRating(incoming()) &&
                      incoming().channelId == existing().channelId &&
                      incoming().timestamp == request.time &&
                      (incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'timestamp']));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isOwner(userId) && request.auth.token.email == 'chaminade.dondah.adjolou@gmail.com');
    }
  }
}
